{
  "name": "@flefebvre/nextasking",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "license": "MIT",
  "author": "Florian Lefebvre <florian.lefebvre.contact@gmail.com>",
  "homepage": "https://github.com/flolefebvre/nextasking#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flolefebvre/nextasking.git"
  },
  "bugs": {
    "url": "https://github.com/flolefebvre/nextasking/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/*.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": "^22.22 || ^24.5 || >=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsx scripts/gate.ts format:check+lint+duplication+typecheck,test:changed",
    "gate": "tsx scripts/gate.ts format:check+lint+duplication+typecheck,test,build,pack:check+typecheck:dist",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack:check": "tsx scripts/pack-check.ts",
    "typecheck:dist": "tsc -p tests/dist-consumer && pnpm --dir tests/dist-consumer exec tsc -p .",
    "prepublishOnly": "pnpm run build",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --max-warnings=0 .",
    "duplication": "jscpd",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:changed": "vitest run --changed ${CHECK_BASE:-origin/main}",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-no-comments": "^1.2.1",
    "jscpd": "^5.4.2",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "bullmq": "6.5.3",
    "ioredis": "~5.11.1"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
