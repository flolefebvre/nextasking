{
  "name": "@flefebvre/nextasking",
  "version": "0.3.0",
  "description": "Typed background tasks and events for Next.js, on Redis or Valkey.",
  "keywords": [
    "nextjs",
    "next",
    "app-router",
    "background-jobs",
    "job-queue",
    "task-queue",
    "queue",
    "worker",
    "cron",
    "scheduled-tasks",
    "events",
    "redis",
    "valkey",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Florian Lefebvre <florian.lefebvre.contact@gmail.com>",
  "homepage": "https://github.com/flolefebvre/nextasking#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flolefebvre/nextasking.git"
  },
  "bugs": {
    "url": "https://github.com/flolefebvre/nextasking/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/*.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": "^22.22 || ^24.5 || >=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsx scripts/gate.ts format:check+lint+duplication+typecheck+manual-links:check,test:changed",
    "gate": "tsx scripts/gate.ts format:check+lint+duplication+typecheck+manual-links:check,test,build,pack:check+typecheck:dist,test:e2e",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "manual-links:check": "tsx scripts/manual-links-check.ts",
    "pack:check": "tsx scripts/pack-check.ts",
    "typecheck:dist": "tsc -p tests/dist-consumer && tsc -p tests/dist-consumer/root-entry-alone && tsc -p tests/dist-consumer/testing-entry-alone && pnpm --dir tests/dist-consumer exec tsc -p . && pnpm --dir tests/dist-consumer exec tsc -p root-entry-alone && pnpm --dir tests/dist-consumer exec tsc -p testing-entry-alone",
    "prepublishOnly": "pnpm run build",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --max-warnings=0 .",
    "duplication": "jscpd",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:contended": "tsx scripts/gate.ts test:integration+test:integration",
    "test:changed": "vitest run --project unit --project integration --changed ${CHECK_BASE:-origin/main}",
    "test:e2e": "vitest run --project e2e",
    "test:benchmark": "vitest run --project benchmark --reporter=default",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-no-comments": "^1.2.1",
    "jscpd": "^5.4.2",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@redis/client": "6.3.1",
    "cron-parser": "5.10.2"
  },
  "peerDependencies": {
    "next": ">=16.0.10",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
