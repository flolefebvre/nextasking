{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@flefebvre/nextasking": ["./stub/nextasking.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
